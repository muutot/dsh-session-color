{
  "name": "@muutot/dsh-session-color",
  "version": "0.2.1",
  "description": "给 DSH 左侧会话列表里的单条对话换背景色：右键会话 → 选颜色，跨会话/跨设备持久保存。兼容 0.2.1-rc.5（自绘菜单）与 0.2.2+（官方 contextMenus）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "shared",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "session", "color", "theme"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muutot/dsh-session-color.git"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  }
}
